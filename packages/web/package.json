{
  "name": "hamrah-web",
  "description": "Your agent buddy",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "deploy": "pnpm run build && wrangler deploy",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "pnpm run build && wrangler dev",
    "serve": "wrangler pages dev ./dist --compatibility-flags=nodejs_als",
    "start": "vite --open --mode ssr",
    "cf-typegen": "wrangler types",
    "prepare": "cd ../.. && husky packages/web/.husky",
    "qwik": "qwik",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "./scripts/run-all-tests.sh",
    "test:ci": "pnpm lint && pnpm build.types && pnpm test:run && pnpm build",
    "pretest:e2e": "pnpm exec playwright install --with-deps"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.4",
    "@builder.io/qwik-city": "^1.20.4",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@qwikest/icons": "^0.0.13",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/ui": "5.1.0",
    "class-variance-authority": "^0.7.1",
    "eslint": "10.14.0",
    "eslint-plugin-qwik": "^1.20.4",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "undici": "^8.12.2",
    "vite": "^8.3.7",
    "vite-plugin-mkcert": "2.1.0",
    "vitest": "5.1.0",
    "wrangler": "^4.160.0"
  },
  "dependencies": {
    "@hamrah/shared": "workspace:*",
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@simplewebauthn/browser": "^14.0.0",
    "arctic": "3.7.0",
    "jose": "6.2.12"
  }
}
