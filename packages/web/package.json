{
  "name": "hamrah-web",
  "description": "Your agent buddy",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/cloudflare-pages/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "pnpm run build && wrangler dev",
    "serve": "wrangler pages dev ./dist --compatibility-flags=nodejs_als",
    "start": "vite --open --mode ssr",
    "cf-typegen": "wrangler types",
    "prepare": "pnpm dlx husky install",
    "qwik": "qwik",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "./scripts/run-all-tests.sh",
    "test:ci": "pnpm lint && pnpm build.types && pnpm test:run && pnpm build",
    "pretest:e2e": "pnpm exec playwright install --with-deps",
    "deadcode": "ts-prune",
    "deadcode:ignored": "bash -c \"ts-prune --ignore $(grep -v '^#' .ts-prune-ignore | paste -sd, -)\""
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@cloudflare/workers-types": "^4.20260615.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@qwikest/icons": "^0.0.13",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "25.9.3",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "class-variance-authority": "^0.7.1",
    "eslint": "10.5.0",
    "eslint-plugin-qwik": "^1.20.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-prune": "^0.10.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "undici": "^8.4.1",
    "vite": "^8.0.16",
    "vite-plugin-mkcert": "2.1.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.100.0"
  },
  "dependencies": {
    "@hamrah/shared": "workspace:*",
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@simplewebauthn/browser": "^13.3.0",
    "arctic": "3.7.0",
    "jose": "6.2.3"
  }
}
